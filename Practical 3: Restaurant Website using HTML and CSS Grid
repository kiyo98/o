<!DOCTYPE html> 
<html> 
<head> 
    <title>Restaurant</title> 
    <style>         body { 
            font-family: Arial;             margin: 20px; 
        }         h1 { 
            text-align: center; 
        } 
        .menu {             display: grid; 
            grid-template-columns: 1fr 1fr;             gap: 10px; 
        } 
        .item { 
            border: 1px solid black;             padding: 10px; 
        } 
        .img {             width: 100%;             height: 120px; 
        } 
        .price { 
            font-weight: bold; 
        } 
    </style> 
</head> 
 
<body> 
   <h1>My Restaurant</h1> 
   <div class="menu"> 
 
    <div class="item"> 
        <img src="https://via.placeholder.com/150"> 
        <h3>Pizza</h3> 
        <p class="price">₹200</p> 
    </div> 
 
    <div class="item"> 
        <img src="https://via.placeholder.com/150"> 
        <h3>Burger</h3> 
        <p class="price">₹120</p> 
    </div> 
 
    <div class="item"> 
        <img src="https://via.placeholder.com/150"> 
        <h3>Pasta</h3> 
        <p class="price">₹180</p> 
    </div> 
 
    <div class="item"> 
        <img src="https://via.placeholder.com/150"> 
        <h3>Cold Coffee</h3> 
        <p class="price">₹90</p> 
    </div> 
 
</div> 
 
</body> 
</html> 
 
 
