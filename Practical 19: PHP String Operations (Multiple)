    $str = $_POST["str"]; 
    $num = $_POST["num"]; 
 
    echo "<h3>Results:</h3>"; 
 
    echo "Uppercase: " . strtoupper($str) . "<br>";     echo "Lowercase: " . strtolower($str) . "<br>";     echo "First Character Uppercase: " . ucfirst($str) . "<br>";     echo "All Words First Letter Uppercase: " . ucwords($str) . "<br>"; 
 
    echo "Remove Leading Zeros: " . ltrim($num, "0") . "<br>"; 
 
    echo "Reverse: " . strrev($str) . "<br>";     echo "Length: " . strlen($str) . "<br>";     echo "Substring (0,3): " . substr($str, 0, 3); 
