<!DOCTYPE html> 
<html> 
<head> 
    <title>Simple Calculator</title> 
 
    <style>         body { 
            font-family: Arial;             margin: 20px; 
        } 
         input {             margin: 5px; 
        } 
    </style> 
 
    <script> 
        function calculate() { 
            let a = parseInt(document.getElementById("num1").value);             let b = parseInt(document.getElementById("num2").value);             let op = document.getElementById("op").value;             let result; 
 
            switch(op) {                 case '+':                     result = a + b;                     break;                  case '-':                     result = a - b;                     break;                  case '*':                     result = a * b;                     break;                  case '/':                     result = a / b;                     break;                  default: 
                    result = "Invalid Operation"; 
            } 
 
            document.getElementById("res").innerHTML = result; 
        } 
    </script> 
</head> 
 
 
 
 
 
 
 
 
<body> 
 
<h2>Simple Calculator</h2> 
 
<input type="text" id="num1" placeholder="Enter number 1"><br> <input type="text" id="num2" placeholder="Enter number 2"><br> 
 
<select id="op"> 
    <option value="+">Addition</option> 
    <option value="-">Subtraction</option> 
    <option value="*">Multiplication</option> 
    <option value="/">Division</option> 
</select><br><br> 
 
<button onclick="calculate()">Calculate</button> 
 
<h3>Result: <span id="res"></span></h3> 
 
</body> 
</html> 
 
